BP_WATCH_ENTITLEMENTS = BookPlayerWatch-SelfHosted
BP_MOCKED_BEARER_TOKEN =
BP_REVENUECAT_KEY =
BP_SENTRY_DSN =
CODE_SIGN_STYLE = Automatic
